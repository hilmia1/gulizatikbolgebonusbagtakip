{
  "rules": {
    ".read": false,
    ".write": false,
    "watsons_v7": {
      ".read": true,
      "settings": {
        ".write": "auth != null && auth.token.email == 'merkez@bonusbag.app'",
        "contestBrands": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "kpiState": {
          ".validate": "newData.isString() && (newData.val() == 'soon' || newData.val() == 'open' || newData.val() == 'maint')"
        },
        "kpiGate": {
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      },
      "central_announcement": {
        ".write": "auth != null && auth.token.email == 'merkez@bonusbag.app'",
        ".validate": "newData.hasChildren(['message', 'time'])",
        "message": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
        },
        "time": {
          ".validate": "newData.isNumber()"
        },
        "startTime": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "endTime": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "$other": {
          ".validate": false
        }
      },
      "global_announcement": {
        "$sender": {
          ".write": "auth != null && (auth.token.email == 'merkez@bonusbag.app' || auth.token.email == 'guliz@bonusbag.app' || auth.token.email == 'bolge@bonusbag.app')",
          ".validate": "$sender.matches(/^[^<>\"'`]{1,40}$/) && newData.hasChildren(['message', 'time'])",
          "message": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
          },
          "time": {
            ".validate": "newData.isNumber()"
          },
          "startTime": {
            ".validate": "newData.isString() && newData.val().length <= 5"
          },
          "endTime": {
            ".validate": "newData.isString() && newData.val().length <= 5"
          },
          "target": {
            ".validate": "newData.val() == 'global' || newData.val() == 'regional'"
          },
          "bm": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().matches(/^[^<>\"'`]*$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "master_staff": {
        "$store": {
          ".validate": "$store.matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)",
          "$id": {
            ".write": true,
            ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60 && newData.val().matches(/^[^<>\"'`]+$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "daily": {
        "$date": {
          ".validate": "$date.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
          "$store": {
            ".validate": "$store.matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)",
            "target": {
              ".write": "(auth != null && auth.token.email == 'merkez@bonusbag.app') || data.parent().child('targetBy').val() != 'MERKEZ'",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "targetBy": {
              ".write": "(auth != null && auth.token.email == 'merkez@bonusbag.app') || (data.val() != 'MERKEZ' && newData.val() != 'MERKEZ')",
              ".validate": "newData.isString() && (newData.val() == 'MM' || newData.val() == 'BM' || newData.val() == 'MERKEZ')"
            },
            "isLocked": {
              ".write": true,
              ".validate": "newData.isBoolean()"
            },
            "hourly": {
              "$hr": {
                ".write": true,
                ".validate": "$hr.matches(/^[0-9]{2}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
              }
            },
            "staff": {
              "$id": {
                ".write": true,
                ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/)",
                "sales": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
                },
                "target": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "applause": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                },
                "contest": {
                  "$brand": {
                    ".validate": "$brand.matches(/^[^<>\"'`]{1,40}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "kpi": {
        ".write": false,
        "active": {
          ".write": "auth != null && auth.token.email == 'merkez@bonusbag.app'",
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,30}$/)"
        },
        "comps": {
          "$cid": {
            ".validate": "$cid.matches(/^[A-Za-z0-9_-]{1,30}$/)",
            "config": {
              ".write": "auth != null && auth.token.email == 'merkez@bonusbag.app'",
              ".validate": "newData.hasChildren(['name','start','end','brands'])",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60 && !newData.val().matches(/[<>\"'`]/)"
              },
              "start": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
              },
              "end": {
                ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
              },
              "createdAt": {
                ".validate": "newData.isNumber()"
              },
              "brands": {
                "$b": {
                  ".validate": "$b.matches(/^b[1-6]$/) && newData.hasChildren(['name','unit'])",
                  "name": {
                    ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60 && !newData.val().matches(/[<>\"'`]/)"
                  },
                  "unit": {
                    ".validate": "newData.val() == 'adet' || newData.val() == 'TL'"
                  },
                  "$o": {
                    ".validate": false
                  }
                }
              },
              "$other": {
                ".validate": false
              }
            },
            "targets": {
              ".write": "auth != null && auth.token.email == 'merkez@bonusbag.app'",
              "stores": {
                "$store": {
                  ".validate": "$store.matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)",
                  "$bk": {
                    ".validate": "$bk.matches(/^b[1-6]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
                  }
                }
              },
              "regions": {
                "$r": {
                  ".validate": "$r.matches(/^[^<>\"'`]{1,60}$/)",
                  "$bk": {
                    ".validate": "$bk.matches(/^b[1-6]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000000"
                  }
                }
              },
              "general": {
                "$bk": {
                  ".validate": "$bk.matches(/^b[1-6]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000"
                }
              },
              "$other": {
                ".validate": false
              }
            },
            "adj": {
              ".write": "auth != null && auth.token.email == 'merkez@bonusbag.app'",
              "$store": {
                ".validate": "$store.matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)",
                "$bk": {
                  ".validate": "$bk.matches(/^b[1-6]$/) && newData.isNumber() && newData.val() >= -1000000000 && newData.val() <= 1000000000"
                }
              }
            },
            "daily": {
              "$date": {
                ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
                "$store": {
                  ".write": true,
                  ".validate": "$store.matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)",
                  "$bk": {
                    ".validate": "$bk.matches(/^b[1-6]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
                  }
                }
              }
            },
            "staff": {
              "$date": {
                ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
                "$store": {
                  ".validate": "$store.matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)",
                  "$id": {
                    ".write": true,
                    ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/)",
                    "$bk": {
                      ".validate": "$bk.matches(/^b[1-6]$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
                    }
                  }
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "stockout": {
        ".write": false,
        "products": {
          ".write": "auth != null && auth.token.email == 'merkez@bonusbag.app'",
          "$pid": {
            ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,30}$/) && newData.hasChildren(['name'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60 && newData.val().matches(/^[^<>\"'`]+$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "reports": {
          "$store": {
            ".validate": "$store.matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)",
            "$pid": {
              ".write": true,
              ".validate": "$pid.matches(/^[A-Za-z0-9_-]{1,30}$/) && root.child('watsons_v7/stockout/products/' + $pid).exists() && newData.hasChildren(['ts'])",
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      },
      "announcement_log": {
        "$id": {
          ".write": "(!data.exists() && newData.exists() && auth != null && (auth.token.email == 'merkez@bonusbag.app' || auth.token.email == 'guliz@bonusbag.app' || auth.token.email == 'bolge@bonusbag.app')) || (auth != null && auth.token.email == 'merkez@bonusbag.app')",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['message','time','by','kind'])",
          "message": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
          },
          "time": {
            ".validate": "newData.isNumber()"
          },
          "by": {
            ".validate": "newData.isString() && newData.val().matches(/^[^<>\"'`]{1,40}$/)"
          },
          "kind": {
            ".validate": "newData.val() == 'central' || newData.val() == 'telsiz'"
          },
          "target": {
            ".validate": "newData.val() == 'global' || newData.val() == 'regional'"
          },
          "bm": {
            ".validate": "newData.isString() && newData.val().matches(/^[^<>\"'`]{1,40}$/)"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "central_announcements": {
        "$id": {
          ".write": "auth != null && auth.token.email == 'merkez@bonusbag.app'",
          ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.hasChildren(['message','time'])",
          "message": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300"
          },
          "time": {
            ".validate": "newData.isNumber()"
          },
          "startTime": {
            ".validate": "newData.isString() && newData.val().length <= 5"
          },
          "endTime": {
            ".validate": "newData.isString() && newData.val().length <= 5"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "records": {
        "region": {
          ".write": true,
          ".validate": "newData.hasChildren(['value','date','time','staffName','store'])",
          "value": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "prev": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "date": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "time": {
            ".validate": "newData.isNumber()"
          },
          "first": {
            ".validate": "newData.isBoolean()"
          },
          "staffId": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,40}$/)"
          },
          "staffName": {
            ".validate": "newData.isString() && newData.val().length <= 60 && !newData.val().matches(/[<>\"'`]/)"
          },
          "store": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)"
          },
          "$other": {
            ".validate": false
          }
        },
        "odak": {
          "$brand": {
            ".write": true,
            ".validate": "$brand.matches(/^[^<>\"'`]{1,40}$/) && newData.hasChildren(['value','date','time','staffName','store'])",
            "value": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "prev": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
            },
            "time": {
              ".validate": "newData.isNumber()"
            },
            "first": {
              ".validate": "newData.isBoolean()"
            },
            "staffId": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{1,40}$/)"
            },
            "staffName": {
              ".validate": "newData.isString() && newData.val().length <= 60 && !newData.val().matches(/[<>\"'`]/)"
            },
            "store": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "watsons_v7_visits": {
      ".read": "auth != null && (auth.token.email == 'merkez@bonusbag.app' || auth.token.email == 'guliz@bonusbag.app')",
      "$date": {
        ".validate": "$date.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/)",
        "$cid": {
          ".write": true,
          ".validate": "$cid.matches(/^[A-Za-z0-9_-]{8,40}$/)",
          "first": {
            ".validate": "newData.isNumber()"
          },
          "last": {
            ".validate": "newData.isNumber()"
          },
          "n": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "role": {
            ".validate": "newData.isString() && newData.val().matches(/^[a-z]{0,10}$/)"
          },
          "store": {
            ".validate": "newData.isString() && (newData.val() == '' || newData.val().matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/))"
          },
          "dev": {
            ".validate": "newData.val() == 'm' || newData.val() == 'd'"
          },
          "app": {
            ".validate": "newData.isBoolean()"
          },
          "h": {
            "$hr": {
              ".validate": "$hr.matches(/^[0-9]{2}$/) && newData.val() == 1"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "watsons_v7_private": {
      ".read": "auth != null && (auth.token.email == 'merkez@bonusbag.app' || auth.token.email == 'guliz@bonusbag.app' || auth.token.email == 'bolge@bonusbag.app')",
      "reconcile": {
        ".write": "auth != null && (auth.token.email == 'merkez@bonusbag.app' || auth.token.email == 'guliz@bonusbag.app')",
        "$key": {
          ".validate": "$key.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['start','end','rows'])",
          "start": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "end": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
          },
          "time": {
            ".validate": "newData.isNumber()"
          },
          "rows": {
            "$store": {
              ".validate": "$store.matches(/^[0-9]{1,4}-[^<>\"'`]{1,60}$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}